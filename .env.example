SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. LinkedIn hides most posts behind an auth wall for logged-out
# visitors; paste the li_at cookie from a logged-in browser to capture those.
LINKEDIN_LI_AT=

# Postgres connection string, only used by `npm run db:push` to create tables.
# Supabase dashboard -> Connect -> Session pooler, then swap in your database
# password. This is NOT the API key above.
DATABASE_URL=

# Optional. Serve screenshots from UnionStack instead of Supabase storage.
# Must be a SERVER key: in the UnionStack dashboard leave its allowed-origins
# list empty. A browser key is rejected here, because uploads come from the
# Next.js server and carry no Origin header. Leave empty to keep using Supabase.
UNIONSTACK_API_KEY=
